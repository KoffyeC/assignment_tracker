{
  "name": "student-planner",
  "version": "1.0.0",
  "private": true,
  "description": "Student Planner with assignments, notes, calendar, settings, and shared navigation.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-static.js",
    "test": "node --test \"tests/**/*.test.js\" && node --test \"selenium/smoke.test.js\" && node --test \"selenium/regression.test.js\"",
    "serve": "python3 -m http.server 8000",
    "test:smoke": "node --test \"selenium/smoke.test.js\"",
    "test:regression": "node --test \"selenium/regression.test.js\"",
    "test:large-data": "node --test \"selenium/large-data.test.js\""
  },
  "devDependencies": {
    "selenium-webdriver": "^4.48.0"
  }
}
